{
  "name": "github-tag-manager",
  "displayName": "GitHub Tag Manager",
  "description": "Visual Git tag manager and language-agnostic semantic versioning helper.",
  "version": "0.4.1",
  "publisher": "igormenin",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/igormenin/GitHubTagManager.git"
  },
  "bugs": {
    "url": "https://github.com/igormenin/GitHubTagManager/issues"
  },
  "homepage": "https://github.com/igormenin/GitHubTagManager#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "tag",
    "manager",
    "semver",
    "versioning",
    "github",
    "release"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "github-tag-manager-sidebar",
          "title": "GitHub Tag Manager",
          "icon": "$(tag)"
        }
      ]
    },
    "views": {
      "github-tag-manager-sidebar": [
        {
          "type": "webview",
          "id": "github-tag-manager-view",
          "name": "Gerenciador de Tags"
        }
      ]
    },
    "commands": [
      {
        "command": "github-tag-manager.open",
        "title": "GitHub Tag Manager: Open Manager",
        "category": "Git"
      },
      {
        "command": "github-tag-manager.refresh",
        "title": "GitHub Tag Manager: Sincronizar",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "GitHub Tag Manager",
      "properties": {
        "github-tag-manager.telemetry.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Permite enviar dados de uso anônimos para melhoria contínua da extensão. / Allows sending anonymous usage statistics to improve the extension."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^16.18.34",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "posthog-node": "^5.36.1"
  }
}
